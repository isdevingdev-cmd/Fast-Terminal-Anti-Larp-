# ---- Solana RPC (required) ----------------------------------------------
# Use a provider with WebSocket support (Helius, Triton, QuickNode...).
# The public mainnet RPC rate-limits logsSubscribe heavily; it works for a demo only.
NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional: explicit WebSocket URL (derived from RPC_URL when omitted)
NEXT_PUBLIC_RPC_WS_URL=

# ---- Platform fee -------------------------------------------------------
# Fee taken on every trade, in basis points (50 = 0.5%). Photon ~100, Axiom ~75.
NEXT_PUBLIC_PLATFORM_FEE_BPS=50
# Wallet receiving the platform fee (set your own address).
NEXT_PUBLIC_FEE_WALLET=

# ---- Trade execution ----------------------------------------------------
# Provider that builds the swap transaction: "pumpportal" (default) or "native" (WIP).
NEXT_PUBLIC_TRADE_PROVIDER=pumpportal
# Optional Jito block engine endpoint for MEV-protected sends.
NEXT_PUBLIC_JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions

# ---- LarpCheck ----------------------------------------------------------
# GitHub token (server-side only) to raise the API rate limit from 60 to 5000 req/h.
GITHUB_TOKEN=

# ---- Branding -----------------------------------------------------------
NEXT_PUBLIC_APP_NAME=FAST
NEXT_PUBLIC_TOKEN_TICKER=$FAST
